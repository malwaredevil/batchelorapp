{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  // Excludes the throwaway fixture check-scheduler-names.test.ts briefly
  // writes into src/ during its integration tests (deleted immediately
  // after each assertion). Without this, a typecheck run that happens to
  // overlap with a test run can catch the file mid-existence and fail on
  // an intentionally-invalid fixture instead of a real error.
  "exclude": [
    "src/_ci_sentinel_scheduler_names_.ts",
    // Throwaway fixtures check-domain-composition.test.ts briefly writes
    // anywhere under src/ during its integration tests (all use a _temp
    // prefix) — same race as above: a concurrent typecheck can catch one
    // mid-existence and fail with TS6053 or on intentionally-invalid code.
    "src/**/_temp*"
  ],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    },
    {
      "path": "../../lib/upload-validation"
    },
    {
      "path": "../../lib/upload-policy"
    },
    {
      "path": "../../lib/ai-actions"
    }
  ]
}
